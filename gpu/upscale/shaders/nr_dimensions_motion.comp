#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(binding=0) uniform sampler2D sourceMotion;
layout(binding=1,rg16f) writeonly uniform image2D executionMotion;
layout(push_constant) uniform Size {uvec2 renderSize;} p;
void main(){ivec2 q=ivec2(gl_GlobalInvocationID.xy),sz=imageSize(executionMotion);if(any(greaterThanEqual(q,sz)))return;
 ivec2 c=clamp(ivec2((vec2(q)+.5)*vec2(p.renderSize)/vec2(sz)),ivec2(0),ivec2(p.renderSize)-1);
 // Convert the vector's pixel coordinate domain once. NGX MVecScale stays 1/1.
 vec2 v=texelFetch(sourceMotion,c,0).rg*vec2(sz)/vec2(p.renderSize);
 imageStore(executionMotion,q,vec4(v,0,0));
}
