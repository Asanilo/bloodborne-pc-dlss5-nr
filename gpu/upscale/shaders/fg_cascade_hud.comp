#version 450
#extension GL_EXT_samplerless_texture_functions : require
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform texture2D real_color;
layout(binding = 1) uniform texture2D hudless_color;
layout(binding = 2) uniform writeonly image2D earlier_frame;
layout(binding = 3) uniform writeonly image2D midpoint_frame;
layout(binding = 4) uniform writeonly image2D later_frame;

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(midpoint_frame)))) {
        return;
    }
    const vec4 color = texelFetch(real_color, pixel, 0);
    if (any(notEqual(color.rgb, texelFetch(hudless_color, pixel, 0).rgb))) {
        // The captures only provide composited color, so translucent HUD pixels keep
        // the portion of the real background already blended into them.
        imageStore(earlier_frame, pixel, color);
        imageStore(midpoint_frame, pixel, color);
        imageStore(later_frame, pixel, color);
    }
}
