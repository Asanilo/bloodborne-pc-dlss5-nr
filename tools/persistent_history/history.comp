   for(int y=-1;y<=1;y++) for(int x=-1;x<=1;x++) {ivec2 n=clamp(c+ivec2(x,y),ivec2(0),ivec2(p.dispatch.yz)-1);float nd=depthAt(n);ok=ok&&sameSurface(nd,d,p.currentProjection.z);edgeResidual=max(edgeResidual,depthResidual(nd,d,p.currentProjection.z));
    vec2 neighbourMotion=texelFetch(motionImage,n,0).xy;motionSpread=max(motionSpread,boundedMotionSpread(mv,neighbourMotion));}
   if(ok) {
    float colourResidual=p.thresholds.z>0.?max(max(difference.r,difference.g),difference.b)/p.thresholds.z:0.;
    float residual=max(max(depthResidual(m.x,expected,p.previousProjection.z),edgeResidual),max(colourResidual,motionSpread));
    // Half precision stores [0.5,1] exactly at the endpoints. Default min=.5
