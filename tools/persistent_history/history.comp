 return finite1(spread)?spread/(1.+spread):1.;
}
bool sameSurface(float a,float b,float projectionZ) {
 if(!depthValid(a)||!depthValid(b))return false;
 if(a>=1.||b>=1.)return a>=1.&&b>=1.;
 // Device-Z tolerance scales with inverse distance, never with device Z itself.
 return abs(a-b)<=max(2e-7,abs(projectionZ-b)*p.thresholds.y);
}
vec3 guide(float bits) { uint u=floatBitsToUint(bits);vec3 q=vec3(u&127u,(u>>7)&255u,(u>>15)&255u)/vec3(127,255,255);return max(exp2(q*32.-16.)-p.thresholds.x,vec3(0)); }
float packed(vec3 c) { vec3 q=clamp((log2(c+p.thresholds.x)+16.)/32.,0.,1.);uvec3 u=uvec3(round(q*vec3(127,255,255)));return uintBitsToFloat(0x3f800000u|u.x|(u.y<<7)|(u.z<<15)); }
bool guideRange(vec3 c) {vec3 l=log2(c+p.thresholds.x);return finite3(c)&&all(greaterThanEqual(c,vec3(0)))&&all(greaterThanEqual(l,vec3(-16)))&&all(lessThanEqual(l,vec3(16)));}
// Bit16 records pixel-local out-of-range edits. Every other reason is candidate-fatal.
bool bankUsable(uint status) { return (status&~16u)==0u; }
bool live(vec4 e,vec4 m) { return finite3(e.rgb)&&finite1(e.a)&&finite1(m.x)&&finite1(m.z)&&finite1(m.w)&&e.a>0.&&e.a>=p.limits.w&&m.z<=p.limits.x&&m.w<=p.limits.y&&m.z>=0.&&m.w>=0.; }
void main() {
 ivec2 c=ivec2(gl_GlobalInvocationID.xy);
 if(p.dispatch.x==5u) {
  uint li=gl_LocalInvocationIndex;bool inside=all(lessThan(c,ivec2(p.dispatch.yz)));
  vec4 e=vec4(0),m=vec4(0);bool valid=false;uint changed=0u;
  if(inside){e=imageLoad(sourceEdit,c);m=imageLoad(sourceMeta,c);valid=guard.value==0u&&bankUsable(state.invalid[min(p.dispatch.w,3u)])&&live(e,m);
   vec3 shown=texelFetch(originOrFallbackEdit,c,0).rgb,raw=texelFetch(rawImage,c,0).rgb;
   changed=uint(finite3(shown)&&finite3(raw)&&any(greaterThan(abs(shown-raw),vec3(.00001))));}
  uvec2 age=valid?uvec2(round(m.z*65536.),round(m.w*256.)):uvec2(0);
  statsSum[li]=uvec4(uint(valid),changed,age);statsMax[li]=age;barrier();
  for(uint n=32u;n>0u;n/=2u){if(li<n){statsSum[li]+=statsSum[li+n];statsMax[li]=max(statsMax[li],statsMax[li+n]);}barrier();}
  if(li==0u){uint b=(gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*6u;for(uint k=0u;k<4u;k++)groups.data[b+k]=statsSum[0][k];groups.data[b+4u]=statsMax[0].x;groups.data[b+5u]=statsMax[0].y;}return;
 }
 if(any(greaterThanEqual(c,ivec2(p.dispatch.yz)))) return;
 uint mode=p.dispatch.x; uint src=min(p.dispatch.w,3u), dst=min(p.flags.x,3u);
 if(mode==0u) { if(all(equal(c,ivec2(0)))) {state.invalid[dst]=0u;state.validPixels=0u;state.rejectedPixels=0u;state.changedPixels=0u;state.oldestFrames=0u;} return; }
 vec4 raw=texelFetch(rawImage,c,0),e=vec4(0),m=vec4(0); bool ok=false;
 if(mode==1u) {
  vec3 origin=texelFetch(originOrFallbackEdit,c,0).rgb, edited=texelFetch(modelOrFallbackMeta,c,0).rgb;
  float d=depthAt(c);
  uint reason=0u;
  if(!finite3(origin)||any(lessThan(origin,vec3(0))))reason|=1u; // raw invalid
  if(!finite3(edited))reason|=2u; // NR nonfinite
  if(any(lessThan(edited,vec3(0))))reason|=4u; // NR negative
  if(!depthValid(d)||p.flags.y!=0u)reason|=8u; // invalid/unsupported depth
  if(!finite1(p.age.z)||!finite1(p.age.w)||p.age.z<0.||p.age.w<0.||p.age.z>p.limits.x||p.age.w>p.limits.y)reason|=32u;
  if(!guideRange(origin))reason|=64u; // origin outside packed-guide range
