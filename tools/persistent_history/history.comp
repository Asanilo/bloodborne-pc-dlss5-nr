   e=vec4(log2((edited+p.thresholds.x)/(origin+p.thresholds.x)),1);m=vec4(d,packed(origin),p.age.zw);
   if(!finite3(e.rgb))reason|=128u; // derived ratio nonfinite
   if(any(greaterThan(abs(e.rgb),vec3(p.thresholds.w))))reason|=16u;
  }
  ok=reason==0u;
  if(!ok) atomicOr(state.invalid[dst],reason);
 } else if(mode==2u) {
  // Preserve candidate-wide numerical rejection through every catch-up bank.
  if(all(equal(c,ivec2(0)))&&state.invalid[src]!=0u) atomicOr(state.invalid[dst],state.invalid[src]);
  vec2 uv=(vec2(c)+.5)/vec2(p.dispatch.yz),mv=texture(motionImage,uv).xy;
  vec2 prev=uv+mv*p.motion.xy/vec2(textureSize(motionImage,0))+p.motion.zw;
  if(finite1(mv.x)&&finite1(mv.y)&&all(greaterThanEqual(prev,vec2(0)))&&all(lessThan(prev,vec2(1)))&&bankUsable(state.invalid[src])&&p.flags.z!=0u) {
   ivec2 q=ivec2(prev*vec2(p.dispatch.yz));e=imageLoad(sourceEdit,q);m=imageLoad(sourceMeta,q);vec2 sourceAge=m.zw;m.zw+=p.age.xy;
   float d=depthAt(c),expected=-1.;bool geometry=previousDepth(d,c,expected);vec3 previous=guide(m.y)*p.limits.z;
   vec3 difference=abs(log2((max(raw.rgb,vec3(0))+p.thresholds.x)/(previous+p.thresholds.x)));
   ok=live(e,m)&&guideRange(raw.rgb)&&finite1(d)&&finite1(p.limits.z)&&p.limits.z>0.&&geometry&&sameSurface(m.x,expected,p.previousProjection.z)&&all(lessThanEqual(difference,vec3(p.thresholds.z)));
   float edgeResidual=0.,motionSpread=0.;
