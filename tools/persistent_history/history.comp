     // samples. Missing/invalid support falls back to that unchanged reference.
     vec2 texel=prev*vec2(p.dispatch.yz)-.5,phase=fract(texel);
     ivec2 base=ivec2(floor(texel));vec3 filtered=vec3(0);
     float filteredConfidence=1.;vec2 oldest=m.zw;bool supported=true;
     for(int y=0;y<2;y++) for(int x=0;x<2;x++) {
      float weight=(x==0?1.-phase.x:phase.x)*(y==0?1.-phase.y:phase.y);
      if(weight<=0.)continue; // Zero-weight taps do not reject image boundaries.
      ivec2 tap=base+ivec2(x,y);
      if(any(lessThan(tap,ivec2(0)))||any(greaterThanEqual(tap,ivec2(p.dispatch.yz)))) {supported=false;continue;}
      vec4 te=imageLoad(sourceEdit,tap),tm=imageLoad(sourceMeta,tap);
      bool sameOrigin=all(equal(tm.zw,sourceAge));tm.zw+=p.age.xy;
      vec3 tapDifference=abs(log2((max(raw.rgb,vec3(0))+p.thresholds.x)/(guide(tm.y)*p.limits.z+p.thresholds.x)));
      bool tapValid=sameOrigin&&live(te,tm)&&sameSurface(tm.x,expected,p.previousProjection.z)&&all(lessThanEqual(tapDifference,vec3(p.thresholds.z)));
      if(!tapValid) {supported=false;continue;}
      float tapColour=p.thresholds.z>0.?max(max(tapDifference.r,tapDifference.g),tapDifference.b)/p.thresholds.z:0.;
      float tapResidual=max(max(depthResidual(tm.x,expected,p.previousProjection.z),edgeResidual),max(tapColour,motionSpread));
