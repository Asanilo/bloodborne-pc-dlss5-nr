layout(std430,binding=12) readonly buffer ReturnGuard {uint value;} guard;
layout(std430,binding=13) writeonly buffer GroupStats {uint data[];} groups;
shared uvec4 statsSum[64];
shared uvec2 statsMax[64];
layout(std140,binding=11) uniform Params {
