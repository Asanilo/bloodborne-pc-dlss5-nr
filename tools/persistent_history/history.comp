// Guide RGB log2 domain [-16,+16] stored in 7/8/8 mantissa bits.
// Fixed exponent avoids NaN canonicalization and subnormal flushing in float image storage.
bool finite1(float x) { return !isnan(x)&&!isinf(x); }
bool finite3(vec3 x) { return !any(isnan(x))&&!any(isinf(x)); }
float depthAt(ivec2 c) { return texelFetch(depthImage,c,0).x; }
bool projectionValid(vec4 v) { return finite3(v.xyz)&&finite1(v.w)&&abs(v.x)>1e-8&&abs(v.y)>1e-8&&v.z>=1.&&v.w<0.; }
bool depthValid(float d) { return finite1(d)&&d>=0.&&d<=1.; }
// Same convention as camera_motion.comp and taa.comp: depth = zs + zo / viewZ.
// Reconstruct in the unjittered current camera, compare in the previous camera.
bool previousDepth(float d,ivec2 c,out float expected) {
 expected=-1.;
 if(p.flags.y!=0u||!depthValid(d)||!projectionValid(p.currentProjection)||!projectionValid(p.previousProjection)||!finite3(p.previousViewZ.xyz)||!finite1(p.previousViewZ.w)) return false;
 if(d>=1.) {expected=1.;return true;}
 float denominator=d-p.currentProjection.z;
 if(denominator>=0.)return false;
 float z=p.currentProjection.w/denominator;
 vec2 ndc=((vec2(c)+.5-p.reserved1.yz)/vec2(p.dispatch.yz))*2.-1.;
 vec4 view=vec4(ndc*z/p.currentProjection.xy,z,1.);
 float previousZ=dot(p.previousViewZ,view);
 if(!finite1(z)||z<=0.||!finite1(previousZ)||previousZ<=0.)return false;
 expected=p.previousProjection.z+p.previousProjection.w/previousZ;
 return depthValid(expected);
}
// Confidence measures evidence inside the existing hard admission set. It is
// independent of elapsed time, display strength and absolute motion magnitude.
float depthResidual(float a,float b,float projectionZ) {
 return clamp(abs(a-b)/max(2e-7,abs(projectionZ-b)*p.thresholds.y),0.,1.);
}
float boundedMotionSpread(vec2 a,vec2 b) {
 if(!finite1(a.x)||!finite1(a.y)||!finite1(b.x)||!finite1(b.y))return 1.;
