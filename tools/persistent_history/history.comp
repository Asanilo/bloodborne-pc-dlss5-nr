#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(binding=0) uniform sampler2D rawImage;
layout(binding=1) uniform sampler2D depthImage;
layout(binding=2) uniform sampler2D motionImage;
layout(rgba16f,binding=3) readonly uniform image2D sourceEdit;
layout(rgba32f,binding=4) readonly uniform image2D sourceMeta;
layout(binding=5) uniform sampler2D originOrFallbackEdit;
layout(binding=6) uniform sampler2D modelOrFallbackMeta;
layout(rgba16f,binding=7) writeonly uniform image2D destEdit;
layout(rgba32f,binding=8) writeonly uniform image2D destMeta;
layout(rgba32f,binding=9) writeonly uniform image2D outputImage;
layout(std430,binding=10) buffer State { uint invalid[4]; uint validPixels; uint rejectedPixels; uint changedPixels; uint oldestFrames; } state;
layout(std140,binding=11) uniform Params {
 uvec4 dispatch; uvec4 flags; vec4 motion; vec4 thresholds; vec4 age; vec4 limits; vec4 reserved1; vec4 reserved2;
} p;
// Guide RGB log2 domain [-16,+16] stored in 7/8/8 mantissa bits.
// Fixed exponent avoids NaN canonicalization and subnormal flushing in float image storage.
bool finite1(float x) { return !isnan(x)&&!isinf(x); }
bool finite3(vec3 x) { return !any(isnan(x))&&!any(isinf(x)); }
float depthAt(ivec2 c) { float d=texelFetch(depthImage,c,0).x; return p.flags.y!=0?1.-d:d; }
vec3 guide(float bits) { uint u=floatBitsToUint(bits);vec3 q=vec3(u&127u,(u>>7)&255u,(u>>15)&255u)/vec3(127,255,255);return max(exp2(q*32.-16.)-p.thresholds.x,vec3(0)); }
float packed(vec3 c) { vec3 q=clamp((log2(c+p.thresholds.x)+16.)/32.,0.,1.);uvec3 u=uvec3(round(q*vec3(127,255,255)));return uintBitsToFloat(0x3f800000u|u.x|(u.y<<7)|(u.z<<15)); }
bool guideRange(vec3 c) {vec3 l=log2(c+p.thresholds.x);return finite3(c)&&all(greaterThanEqual(c,vec3(0)))&&all(greaterThanEqual(l,vec3(-16)))&&all(lessThanEqual(l,vec3(16)));}
bool live(vec4 e,vec4 m) { return finite3(e.rgb)&&finite1(e.a)&&finite1(m.x)&&finite1(m.z)&&finite1(m.w)&&e.a>=p.limits.w&&m.z<=p.limits.x&&m.w<=p.limits.y&&m.z>=0.&&m.w>=0.; }
void main() {
 ivec2 c=ivec2(gl_GlobalInvocationID.xy); if(any(greaterThanEqual(c,ivec2(p.dispatch.yz)))) return;
 uint mode=p.dispatch.x; uint src=min(p.dispatch.w,3u), dst=min(p.flags.x,3u);
 if(mode==0u) { if(all(equal(c,ivec2(0)))) {state.invalid[dst]=0u;state.validPixels=0u;state.rejectedPixels=0u;state.changedPixels=0u;state.oldestFrames=0u;} return; }
 vec4 raw=texelFetch(rawImage,c,0),e=vec4(0),m=vec4(0); bool ok=false;
 if(mode==1u) {
  vec3 origin=texelFetch(originOrFallbackEdit,c,0).rgb, edited=texelFetch(modelOrFallbackMeta,c,0).rgb;
  float d=depthAt(c);
  ok=guideRange(origin)&&finite3(edited)&&finite1(d)&&all(greaterThanEqual(origin,vec3(0)))&&all(greaterThanEqual(edited,vec3(0)));
  if(ok) {e=vec4(log2((edited+p.thresholds.x)/(origin+p.thresholds.x)),1);m=vec4(d,packed(origin),p.age.zw);ok=live(e,m)&&all(lessThanEqual(abs(e.rgb),vec3(p.thresholds.w)));}
  if(!ok) atomicOr(state.invalid[dst],1u);
 } else if(mode==2u) {
  vec2 uv=(vec2(c)+.5)/vec2(p.dispatch.yz),mv=texture(motionImage,uv).xy;
  vec2 prev=uv+mv*p.motion.xy/vec2(textureSize(motionImage,0))+p.motion.zw;
  if(finite1(mv.x)&&finite1(mv.y)&&all(greaterThanEqual(prev,vec2(0)))&&all(lessThan(prev,vec2(1)))&&state.invalid[src]==0u&&p.flags.z!=0u) {
   ivec2 q=ivec2(prev*vec2(p.dispatch.yz));e=imageLoad(sourceEdit,q);m=imageLoad(sourceMeta,q);m.zw+=p.age.xy;
   float d=depthAt(c);vec3 previous=guide(m.y)*p.limits.z;
   vec3 difference=abs(log2((max(raw.rgb,vec3(0))+p.thresholds.x)/(previous+p.thresholds.x)));
   ok=live(e,m)&&guideRange(raw.rgb)&&finite1(d)&&finite1(p.limits.z)&&p.limits.z>0.&&abs(d-m.x)<=p.thresholds.y*max(abs(d),.001)&&all(lessThanEqual(difference,vec3(p.thresholds.z)));
   // Local depth edge rejects even a low-frequency correction at disocclusion boundaries.
   for(int y=-1;y<=1;y++) for(int x=-1;x<=1;x++) {ivec2 n=clamp(c+ivec2(x,y),ivec2(0),ivec2(p.dispatch.yz)-1);float nd=depthAt(n);ok=ok&&finite1(nd)&&abs(nd-d)<=p.thresholds.y*max(abs(d),.001);}
   m.xy=vec2(d,packed(raw.rgb));
  }
 } else {
  e=imageLoad(sourceEdit,c);m=imageLoad(sourceMeta,c);ok=state.invalid[src]==0u&&live(e,m);
  if(mode==3u&&!ok) {e=texelFetch(originOrFallbackEdit,c,0);m=texelFetch(modelOrFallbackMeta,c,0);ok=state.invalid[min(p.flags.w,3u)]==0u&&live(e,m);}
 }
 if(!ok) {e=vec4(0);m=vec4(0);atomicAdd(state.rejectedPixels,1u);} else {atomicAdd(state.validPixels,1u);atomicMax(state.oldestFrames,uint(ceil(m.z)));}
 if(mode==4u) {vec3 rgb=ok?max((max(raw.rgb,vec3(0))+p.thresholds.x)*exp2(e.rgb)-p.thresholds.x,vec3(0)):raw.rgb;imageStore(outputImage,c,vec4(rgb,raw.a));if(ok&&any(greaterThan(abs(rgb-raw.rgb),vec3(.00001))))atomicAdd(state.changedPixels,1u);}
 else {imageStore(destEdit,c,e);imageStore(destMeta,c,m);}
}
