 if(mode==4u) {vec3 rgb=ok?max((max(raw.rgb,vec3(0))+p.thresholds.x)*exp2(e.rgb)-p.thresholds.x,vec3(0)):raw.rgb;if(p.reserved1.w!=1.)rgb=mix(raw.rgb,rgb,p.reserved1.w);imageStore(outputImage,c,vec4(rgb,raw.a));if(p.reserved1.x>0.&&ok&&any(greaterThan(abs(rgb-raw.rgb),vec3(.00001))))atomicAdd(state.changedPixels,1u);}
 else {imageStore(destEdit,c,e);imageStore(destMeta,c,m);}
}
