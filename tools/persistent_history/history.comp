#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(binding=0) uniform sampler2D rawImage;
layout(binding=1) uniform sampler2D depthImage;
layout(binding=2) uniform sampler2D motionImage;
layout(rgba16f,binding=3) readonly uniform image2D sourceEdit;
layout(rgba32f,binding=4) readonly uniform image2D sourceMeta;
layout(binding=5) uniform sampler2D originOrFallbackEdit;
layout(binding=6) uniform sampler2D modelOrFallbackMeta;
layout(rgba16f,binding=7) writeonly uniform image2D destEdit;
layout(rgba32f,binding=8) writeonly uniform image2D destMeta;
layout(rgba32f,binding=9) writeonly uniform image2D outputImage;
