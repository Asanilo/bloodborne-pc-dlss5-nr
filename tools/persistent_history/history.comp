 } else {
  e=imageLoad(sourceEdit,c);m=imageLoad(sourceMeta,c);ok=bankUsable(state.invalid[src])&&live(e,m);
  if(mode==3u&&!ok) {e=texelFetch(originOrFallbackEdit,c,0);m=texelFetch(modelOrFallbackMeta,c,0);ok=bankUsable(state.invalid[min(p.flags.w,3u)])&&live(e,m);}
